# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=soccer
POSTGRES_USER=soccer
POSTGRES_PASSWORD=soccer
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# ── JWT (MUST mirror the NestJS backend exactly) ──────────────────────────────
# Separate secrets for access and refresh, same as NestJS.
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
# NestJS uses strings like "30d" / "60d" / "15m". Keep the same values.
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=60d

# ── Email (nodemailer-compatible SMTP) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ── Super Admin bootstrap (mirrors NestJS onModuleInit) ───────────────────────
SUPER_ADMIN_EMAIL=admin@soccer.com
SUPER_ADMIN_PASSWORD=Admin123!

# ── One-time Mongo → Postgres data migration source (read-only) ───────────────
MONGODB_URI=
